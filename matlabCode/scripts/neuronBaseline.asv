plotFilled(mean(allTarget(ind==1,:), 1, 'omitmissing'), allFocusSpikes(ind==1,:), color1);
title('type I')
ylim([-0.2 0.1])
xlabel('Qsum')
ylabel('zscored spike/s baseline')
subplot(1,2,2);
plotFilled(mean(allTarget(ind==2,:), 1, 'omitmissing'), allFocusSpikes(ind==2,:), color2);
title('type II')
ylim([-0.2 0.1])
xlabel('Qsum')
