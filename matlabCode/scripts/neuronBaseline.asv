figure2Wide;
subplot(1,2,1);
plotFilled(mean(allTarget(ind==1&sigs(:,contains(regressorsLm, 'Q'))<0,:), 1, 'omitmissing'), allFocusSpikes(ind==1&sigs(:,contains(regressorsLm, 'Q'))<0,:), color1);
title('type I')
% ylim([-0.1 0.2])
xlabel('Qsum')
ylabel('zscored spike/s baseline')
subplot(1,2,2);
plotFilled(mean(allTarget(ind==2&sigs(:,contains(regressorsLm, 'Q'))<0,:), 1, 'omitmissing'), allFocusSpikes(ind==2&sigs(:,contains(regressorsLm, 'Q'))<0,:), color2);
title('type II')
% ylim([-0.1 0.2])
xlabel('Qsum')
%% PSTH
colorsPSTH = zeros(numBins, 3);
for i = 1:numBins
    colorsPSTH(i, :) = [1 0.3*(-i+numBins), 0.3*(-i+numBins)]; 
end

figure2Wide
subplot(1, 2, 1)
for b = 1:numBins
    temp = squeeze(allPSTH(b,:,ind==1))';
    plotFilled(slideTime, temp, colorsPSTH(b,:));    
end
title('type I')
legend({'Low Q','','','','','','High Q'})

subplot(1, 2, 2)
for b = 1:numBins
    temp = squeeze(allPSTH(b,:,ind==2))';
    plotFilled(slideTime, temp, colorsPSTH(b,:));    
end
title('type II')
