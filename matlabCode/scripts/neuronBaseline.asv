append_pdfs([saveDir combineFile],allFiles{:});
%%
bins = 20;
figure2;
colors = cool(length(regressorsLm));
for i = 1:length(regressorsLm)
    subplot(2, length(regressorsLm), i)
    hold on
    edges = linspace(min(tStats(:,i))-0.001, max(tStats(:,i))+0.001, bins);
    histogram(tStats(sigs(:,i)~=0 & ind==1, i), edges, 'FaceColor', colors(i,:), 'EdgeColor', 'none')
    histogram(tStats(sigs(:,i)==0 & ind==1, i), edges, 'FaceColor', [0.3 0.3 0.3], 'EdgeColor', 'none')
    title([regressorsLm{i} ' Type I'])
    xlim([edges(1) edges(end)])


    subplot(2, length(regressorsLm), i + length(regressorsLm))
    hold on
    histogram(tStats(sigs(:,i)~=0 & ind==2, i), edges, 'FaceColor', colors(i,:), 'EdgeColor', 'none')
    histogram(tStats(sigs(:,i)==0 & ind==2, i), edges, 'FaceColor', [0.3 0.3 0.3], 'EdgeColor', 'none')
    title([regressorsLm{i} ' Type II'])
    xlim([edges(1) edges(end)])
end
sgtitle(['pre' num2str(focusWin(1)) 'post' num2str(focusWin(2))])
%%
 load('F:\tmpData\allUnitAUC.mat', 'coeffsMax', 'tStatsMax', 'outcomeInd', 'outcomeInd', 'sigMax');
%% scatter plot
figure2Wide;
currReg = 'Q';
subplot(1,2,1);
hold on;
currInd = sigMax(:, outcomeInd)~= 0 & sigs(:, contains(regressorsLm, currReg)) ~= 0;
scatter(tStatsMax(ind==1 & currInd, outcomeInd), tStats(ind==1 & currInd, contains(regressorsLm, currReg)), 'r');
currInd = sigMax(:, outcomeInd)== 0 & sigs(:, contains(regressorsLm, currReg)) == 0;
scatter(tStatsMax(ind==1 & currInd, outcomeInd), tStats(ind==1 & currInd, contains(regressorsLm, currReg)), [], [0.5 0.5 0.5]);
currInd = sigMax(:, outcomeInd) + abs(sigs(:, contains(regressorsLm, currReg))) == 1;
scatter(tStatsMax(ind==1 & currInd, outcomeInd), tStats(ind==1 & currInd, contains(regressorsLm, currReg)), [], [1,0.6,0]);
title('Type I')
xlabel('rwdWin')
ylabel('baseline')

subplot(1,2,2);
hold on;
currInd = sigMax(:, outcomeInd)~= 0 & sigs(:, contains(regressorsLm, currReg)) ~= 0;
scatter(tStatsMax(ind==2 & currInd, outcomeInd), tStats(ind==2 & currInd, contains(regressorsLm, currReg)), 'r');
currInd = sigMax(:, outcomeInd)== 0 & sigs(:, contains(regressorsLm, currReg)) == 0;
scatter(tStatsMax(ind==2 & currInd, outcomeInd), tStats(ind==2 & currInd, contains(regressorsLm, currReg)), [], [0.5 0.5 0.5]);
currInd = sigMax(:, outcomeInd) + abs(sigs(:, contains(regressorsLm, currReg))) == 1;
scatter(tStatsMax(ind==2 & currInd, outcomeInd), tStats(ind==2 & currInd, contains(regressorsLm, currReg)), [], [1,0.6,0]);
title('Type II')
xlabel('rwdWin')
ylabel('baseline')
%% polar histogram
figure2;
edges = linspace(-pi, pi, 15);
allVec = [tStatsMax(:, outcomeInd), tStats(:, contains(regressorsLm, currReg))];
[theta1, rho] = cart2pol(allVec(ind==1,1), allVec(ind==1,2));
[theta2, rho] = cart2pol(allVec(ind==2,1), allVec(ind==2,2));

polarhistogram(theta1,edges, 'FaceColor', color1, 'FaceAlpha',.7, 'EdgeColor', 'none', 'Normalization', 'Probability');
hold on; 
polarhistogram(theta2,edges, 'FaceColor', color2, 'FaceAlpha',.6, 'EdgeColor', 'none', 'Normalization', 'Probability');

title('maxWin Qchosen vs baseline Qsum')
%% tuning curve
