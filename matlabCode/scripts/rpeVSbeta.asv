% allGt
% compare next trial likelihood.
% animal level params and session level params. With or without
% experimental prior
file = 'inhibitionGt';
sheet = 'allGt';
col = 'cueOnGood';
modelName = '5params_k_bias_LaserNegRPE';
modelNameExp = '5params_k_bias_LaserDisengageScale';
dayList = getDayList(file, sheet, col);
numSamps = 10000;
[root, sep] = currComputer();
%%
llCombined = [];
llCombinedExp = [];
laserCombined = [];
svsCombined = [];
rwdCombined = [];

meanLLAll = NaN(1, length(dayList));
meanLLNext = NaN(1, length(dayList));
meanLLNextSw = NaN(1, length(dayList));
meanLLNextNrwd = NaN(1, length(dayList));
meanLLNextRwd = NaN(1, length(dayList));


meanLLAllExp = NaN(1, length(dayList));
meanLLNextExp = NaN(1, length(dayList));
meanLLNextSwExp = NaN(1, length(dayList));
meanLLNextNrwdExp = NaN(1, length(dayList));
meanLLNextRwdExp = NaN(1, length(dayList));

for i = 1:length(dayList)
    session = dayList{i};
    s = behAnalysisNoPlot_opMD(session, 'simpleFlag', 1);
    pd = parseSessionString_df(session, root, sep);    
    svs = zeros(1, length(s.allChoices));
    svs(s.changeChoice_Inds) = 1;
    
    outcomes = abs(s.allRewards);
   
    laserCombined = [laserCombined; s.laser'];
    svsCombined = [svsCombined; svs'];   
    rwdCombined = [rwdCombined; outcomes'];
    
    % shift model
    params = getStanModelParams_sampsOnly(pd.animalName, col, modelName, numSamps, 'sessionName', session, 'sessionParamsFlag', 1);
    t = inferModelVar(session, params, modelName, 'perturb', 1);
    
    llCombined = [llCombined; log(t.probChoice)];
    meanLLAll(i) = mean(log(t.probChoice));
    meanLLNext(i) = mean(log(t.probChoice(mintersect(find(s.laser==1)+1, 1:length(s.allChoices)))));
    meanLLNextSw(i) = mean(log(t.probChoice(mintersect(find(s.laser==1)+1, s.nrwd_Inds+1, s.changeChoice_Inds, 1:length(s.allChoices)))));
    meanLLNextNrwd(i) = mean(log(t.probChoice(mintersect(s.nrwd_Inds+1, 1:length(s.allChoices)))));
    meanLLNextRwd(i) = mean(log(t.probChoice(mintersect(s.rwd_Inds+1, 1:length(s.allChoices)))));
    
    % explore model
    params = getStanModelParams_sampsOnly(pd.animalName, col, modelNameExp, numSamps, 'sessionName', session, 'sessionParamsFlag', 1);
    tExp = inferModelVar(session, params, modelNameExp, 'perturb', 1);
    
    llCombinedExp = [llCombinedExp; log(tExp.probChoice)];
    meanLLAllExp(i) = mean(log(tExp.probChoice));
    meanLLNextExp(i) = mean(log(tExp.probChoice(mintersect(find(s.laser==1)+1, 1:length(s.allChoices)))));
    meanLLNextSwExp(i) = mean(log(tExp.probChoice(mintersect(find(s.laser==1)+1, s.nrwd_Inds+1, s.changeChoice_Inds, 1:length(s.allChoices)))));
    meanLLNextNrwdExp(i) = mean(log(tExp.probChoice(mintersect(s.nrwd_Inds+1, 1:length(s.allChoices)))));
    meanLLNextRwdExp(i) = mean(log(tExp.probChoice(mintersect(s.rwd_Inds+1, 1:length(s.allChoices)))));
    
end
%% compare
figure2;
subplot(2,1,1)
edges = linspace(-0.015, 0.0053, 20);
histogram(meanLLAll - meanLLAllExp, edges);
[p, h, t] = signrank(meanLLAll - meanLLAllExp);
title(['p= ' num2str(p)])

subplot(2,1,2); hold on;
scatter(meanLLAll, meanLLAllExp, 12, 'k', 'filled')
plot([min(meanLLAllExp), max(meanLLAll)], [min(meanLLAllExp), max(meanLLAll)], 'r', 'LineStyle', '--')
%% compare post laser
figure2;
subplot(2,1,1)
edges = linspace(-0.03, 0.025, 12);
histogram(meanLLNext - meanLLNextExp, edges);
[p, h, t] = signrank(meanLLNext - meanLLNextExp);
title(['p= ' num2str(p)])

subplot(2,1,2); hold on;
scatter(meanLLNext, meanLLNextExp, 12, 'k', 'filled')
plot([min(meanLLNextExp), max(meanLLNext)], [min(meanLLNextExp), max(meanLLNext)], 'r', 'LineStyle', '--')
%% compare post laser corrected by trial type
figure2;
subplot(2,1,1)
histogram((meanLLNextNrwd+meanLLNextRwd)/2 - (meanLLNextNrwdExp+meanLLNextRwdExp)/2, 15);
[p, h, t] = signrank((meanLLNextNrwd+meanLLNextRwd)/2 - (meanLLNextNrwdExp+meanLLNextRwdExp)/2);
title(['p= ' num2str(p)])

subplot(2,1,2); hold on;
scatter((meanLLNextNrwd+meanLLNextRwd)/2, (meanLLNextNrwdExp+meanLLNextRwdExp)/2, 12, 'k', 'filled')
plot([min(meanLLNextNrwdExp+meanLLNextRwdExp), max(meanLLNextNrwd+meanLLNextRwd)]/2, [min(meanLLNextNrwdExp+meanLLNextRwdExp), max(meanLLNextNrwd+meanLLNextRwd)]/2, 'r', 'LineStyle', '--')
%% %% compare post laser and nrwd
figure2;
subplot(2,1,1)
histogram(meanLLNextNrwd - meanLLNextNrwdExp, 15);
[p, h, t] = signrank(meanLLNextNrwd - meanLLNextNrwdExp);
title(['p= ' num2str(p)])

subplot(2,1,2); hold on;
scatter(meanLLNextNrwd, meanLLNextNrwdExp, 12, 'k', 'filled')
plot([min(meanLLNextNrwdExp), max(meanLLNextNrwd)], [min(meanLLNextNrwdExp), max(meanLLNextNrwd)], 'r', 'LineStyle', '--')
%% compare after rwd
figure2;
subplot(2,1,1)
histogram(meanLLNextNrwd - meanLLNextNrwdExp, 15);
[p, h, t] = signrank(meanLLNextNrwd - meanLLNextNrwdExp);
title(['p= ' num2str(p)])

subplot(2,1,2); hold on;
scatter(meanLLNextNrwd, meanLLNextNrwdExp, 12, 'k', 'filled')
plot([min(meanLLNextNrwdExp), max(meanLLNextNrwd)], [min(meanLLNextNrwdExp), max(meanLLNextNrwd)], 'r', 'LineStyle', '--')
%% compare model directly
model = '5params_k_bias_LaserNegRPE_expPrior';
modelExp = '5params_k_bias_LaserDisengageScale_expPrior';

fileName = [sheet col '_' model];
modelPath = [root sheet sep sheet 'sorted' sep 'stan' sep 'bernoulli' sep model sep col sep fileName '.mat'];
load(modelPath)
eval(['fittedModel = ' fileName ';'])
eval(['clear ' fileName ]);

fileNameExp = [sheet col '_' modelExp];
modelPathExp = [root sheet sep sheet 'sorted' sep 'stan' sep 'bernoulli' sep modelExp sep col sep fileNameExp '.mat'];
load(modelPathExp)
eval(['fittedModelExp = ' fileNameExp ';'])
eval(['clear ' fileNameExp ]);

meanLLAllStan = mean(fittedModel.log_likMean);
meanLLAllStanExp = mean(fittedModelExp.log_likMean);

figure2;
subplot(2,1,1)
histogram(meanLLAllStan - meanLLAllStanExp, 15);
[p, h, t] = signrank(meanLLAllStan - meanLLAllStanExp);
title(['p= ' num2str(p)])

subplot(2,1,2); hold on;
scatter(meanLLAllStan, meanLLAllStanExp, 12, 'k', 'filled')
plot([min(meanLLAllStan), max(meanLLAllStanExp)], [min(meanLLAllStan), max(meanLLAllStanExp)], 'r', 'LineStyle', '--')
%%
